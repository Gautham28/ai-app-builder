# Copy to .env and fill in. Never commit .env.
# Values differ per environment (local / staging / production) — the names do not.

# ─── Clerk (auth + billing) ───────────────────────────────────────────────────
# Development instances use pk_test_/sk_test_. Production needs pk_live_/sk_live_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Database (Postgres) ──────────────────────────────────────────────────────
# DATABASE_URL is the pooled connection used at runtime.
# DIRECT_URL is the direct connection used by migrations, and is required at
# build time because `npm run build` runs `prisma migrate deploy`.
DATABASE_URL=
DIRECT_URL=

# ─── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Security ─────────────────────────────────────────────────────────────────
ARCJET_KEY=

# ─── Storage (Supabase) ───────────────────────────────────────────────────────
# The service role key bypasses row level security and is used only by
# /api/upload on the server. It must never be exposed with a NEXT_PUBLIC_ prefix.
# The bucket `workspace-images` should allow no anonymous writes.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
